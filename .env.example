# =====================================================================
# BeviGrow AI Outreach Automation - configuration
# ---------------------------------------------------------------------
# HOW TO USE:
#   1. Copy this file and rename the copy to  .env
#   2. Fill in the values marked  <-- YOU MUST PROVIDE
#   3. Never commit .env to git (.gitignore already blocks it)
# =====================================================================


# ---------------------------------------------------------------------
# 1. SAFETY SWITCHES  (leave as-is until your first test succeeds)
# ---------------------------------------------------------------------

# true  = NOTHING is ever really sent. Emails/forms are simulated and saved
#         to data/outbox/ so you can read exactly what would have gone out.
# false = real sending becomes possible (approval is still required).
TEST_MODE=true

# true  = every message must be approved by you in the terminal before sending.
# Keep this true. Only set to false once you fully trust the output.
REQUIRE_APPROVAL=true

# Extra brake: even with TEST_MODE=false, the system refuses to send unless
# this is also true. Two switches means you cannot send by accident.
ALLOW_REAL_SENDING=false

# Never auto-send follow-ups. true = only prepare + remind you.
FOLLOW_UP_APPROVAL_REQUIRED=true


# ---------------------------------------------------------------------
# 2. SENDING LIMITS  (protects your Gmail reputation)
# ---------------------------------------------------------------------
MAX_COMPANIES_PER_RUN=1
SEND_RATE_LIMIT_SECONDS=45
DAILY_SEND_LIMIT=25
FOLLOW_UP_DAYS=7
# Do not contact the same company again within this many days.
DUPLICATE_COOLDOWN_DAYS=90


# ---------------------------------------------------------------------
# 3. BEVIGROW TRACKER (your existing app)          <-- YOU MUST PROVIDE
# ---------------------------------------------------------------------
# Backend was auto-detected from your live frontend. Leave the base URL alone.
BEVIGROW_API_BASE=https://bevigrow-backend-dkay.onrender.com
# The email + password you use to log in at
# https://bevigrow-frontend-dkay.onrender.com
# Tip: create a separate user called "Automation" instead of using your own.
BEVIGROW_EMAIL=
BEVIGROW_PASSWORD=


# ---------------------------------------------------------------------
# 4. GMAIL SENDING                                  <-- YOU MUST PROVIDE
# ---------------------------------------------------------------------
# The Gmail/Google Workspace address outreach is sent FROM.
GMAIL_SENDER=
# Downloaded from Google Cloud Console (OAuth desktop client).
# Put the downloaded file at this exact path. Your password is never stored.
GMAIL_CREDENTIALS_FILE=config/gmail_credentials.json
GMAIL_TOKEN_FILE=config/gmail_token.json
# Optional: BCC every outreach to yourself for your own records.
OUTREACH_BCC=


# ---------------------------------------------------------------------
# 5. RESEARCH: CLAUDE                               <-- YOU MUST PROVIDE
# ---------------------------------------------------------------------
# From https://console.anthropic.com  (Settings -> API keys).
# NOTE: a Claude.ai / Claude Code subscription is NOT an API key - it is
# billed separately and you top it up with credit.
# Without this key the system still runs, but relevance scoring and
# personalisation fall back to simple rules instead of real reasoning.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Cheaper model used for bulk/low-stakes extraction steps.
ANTHROPIC_FAST_MODEL=claude-sonnet-5
LLM_ENABLED=true


# ---------------------------------------------------------------------
# 6. RESEARCH: WEB SEARCH  (optional - improves website discovery)
# ---------------------------------------------------------------------
# auto = use whichever key below is present, else fall back to DuckDuckGo.
SEARCH_PROVIDER=auto
# https://tavily.com  - generous free tier, recommended
TAVILY_API_KEY=
# https://serper.dev  - alternative
SERPER_API_KEY=


# ---------------------------------------------------------------------
# 7. YOUR SIGNATURE / SENDER IDENTITY               <-- YOU MUST PROVIDE
# ---------------------------------------------------------------------
SENDER_NAME=
SENDER_TITLE=
SENDER_COMPANY=BeviGrow
SENDER_PHONE=
SENDER_WEBSITE=
SENDER_LOCATION=Yercaud, Tamil Nadu, India
# Your own LinkedIn profile (used only in the manual LinkedIn task list).
SENDER_LINKEDIN=


# ---------------------------------------------------------------------
# 8. CRAWLER BEHAVIOUR (safe defaults - normally leave alone)
# ---------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=25
CRAWL_MAX_PAGES=12
CRAWL_DELAY_SECONDS=1.0
USER_AGENT=BeviGrowOutreachBot/1.0 (+https://bevigrow.com; B2B green coffee enquiry)
RESPECT_ROBOTS_TXT=true
