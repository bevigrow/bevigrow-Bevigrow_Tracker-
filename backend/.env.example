# ---------------------------------------------------------------- database
# Neon PostgreSQL (serverless). Create separate branches/databases for
# development and production, then paste the pooled connection string here.
# The `+psycopg` driver and `sslmode=require` are both required.
# A plain `postgresql://...` URL copied straight from the Neon dashboard also
# works — the app rewrites it onto the psycopg 3 driver automatically.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/DBNAME?sslmode=require

# Tables live in their own schema, so BeviGrow can share a Neon database with
# Neon Auth or anything else already sitting in `public`.
DB_SCHEMA=bevigrow

# Connection pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------- auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --------------------------------------------------------------------- ai
# Which backend to use. "auto" prefers Gemini (free tier) when its key is set,
# otherwise Anthropic. Force one with "gemini" or "anthropic".
# With no key at all the app uses built-in rules and never fails.
AI_PROVIDER=auto

# Google Gemini — FREE tier, no credit card. Get a key in ~1 minute at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude Haiku — paid (about $1 per million input tokens).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

AI_MAX_TOKENS=900

# ---------------------------------------------------------------- runtime
ENVIRONMENT=development
# Comma-separated origins, or * for any (development only).
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# ------------------------------------------------------------------- auth
# Google Identity Services OAuth *client ID* (public by design — it identifies
# the app to Google and appears in every browser sign-in). The client SECRET is
# not used and must never be put here: ID-token verification does not need one.
# Blank disables Google sign-in and hides the button.
GOOGLE_CLIENT_ID=

# false = invite-only. Only an admin can create accounts, from the Team page.
# true  = anyone may register and lands in DEFAULT_SIGNUP_ROLE.
ALLOW_SELF_SIGNUP=false
DEFAULT_SIGNUP_ROLE=employee

# Optional allow-list for signup and Google sign-in, e.g. "bevigrow.com".
# Blank permits any domain.
ALLOWED_EMAIL_DOMAINS=

# Where password-reset links point. Must be the deployed frontend URL.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_TTL_MINUTES=60

# SMTP for reset emails. Leave SMTP_HOST blank and no mail is sent — an admin
# can still set a password directly from the Team page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BeviGrow <no-reply@bevigrow.local>
SMTP_STARTTLS=true

# ------------------------------------------------------------ seed admin
SEED_ADMIN_EMAIL=bevigrow@gmail.com
SEED_ADMIN_PASSWORD=Bevi@GROW30@
SEED_ADMIN_NAME=BeviGrow Admin
