# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local database + uploads
*.db
*.sqlite3
backend/uploads/*
!backend/uploads/.gitkeep

# Node
node_modules/
dist/
.vite/

# Environment — never commit real secrets.
# Broad patterns on purpose: a bare `.env` rule does not match copies such as
# "backend/ (2).env" or ".env.backup", which is exactly how credentials leak.
.env
.env.*
*.env
!.env.example
!*.env.example

# Editors / OS
.DS_Store
Thumbs.db
.idea/
*.swp

tsconfig.tsbuildinfo

# Claude Code local machine settings
.claude/settings.local.json
