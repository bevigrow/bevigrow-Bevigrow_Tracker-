# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local database + uploads
*.db
*.sqlite3
backend/uploads/*
!backend/uploads/.gitkeep

# Node
node_modules/
dist/
.vite/

# Environment — never commit real secrets.
# Deliberately broad: editors and browsers produce copies like
# "backend/ (2).env", ".env.txt" and ".env (2).txt". Narrow rules miss those,
# which is exactly how live credentials end up in a public repo.
**/.env*
**/*.env*
# ...but the templates must stay tracked.
!**/.env.example
!**/*.env.example

# Editors / OS
.DS_Store
Thumbs.db
.idea/
*.swp

tsconfig.tsbuildinfo

# Claude Code local machine settings
.claude/settings.local.json
